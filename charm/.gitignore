# The repository-root .gitignore excludes `Makefile` (it assumes CMake
# projects). This build is hand-written make, so re-include ours.
!Makefile

# Generated by charmc from barnes.ci
barnes.decl.h
barnes.def.h

# Generated by `make depends`; contains absolute paths into the Charm++ tree
Makefile.dep

# Records the TRACE= setting the current binary was linked with
.tracemode

# Charm++ cloned and built by build.sh
_deps/

# Records the Charm++ build that build.sh used, for run.sh to find
.build.env

# Build products
barnes
gen
plummer
charmrun
conv-host
*.o

# Generated input data
*.bin
*.csv

# ParaView snapshots
*.vtp
*.pvtp
*.pvd

# Projections traces
*.log
*.sts
*.projrc
*.topo
